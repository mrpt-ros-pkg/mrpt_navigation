<!--
  Integration test world for mrpt_trajectory_follower: a compact car-like
  robot (Ackermann steering, ~0.36 m min turn radius, 1.75 m x 0.86 m) in the
  first of a set of narrow aisles between rows of static boxes, facing out of
  it toward a 2.5 m wide crossing aisle bounded by another row of boxes.

  Aisles run along +x, 1.8 m apart (1.4 m free between box rows); their open
  ends are at x=1.5. The robot starts at the origin (map = world frame).
-->
<mvsim_world version="1.0">
  <simul_timestep>0.005</simul_timestep>
  <joystick_enabled>false</joystick_enabled>

  <element class="ground_grid">
    <floating>true</floating>
  </element>

  <vehicle:class name="compact_car">
    <dynamics class="ackermann">
      <rl_wheel pos="0  0.30" mass="6.0" width="0.10" diameter="0.50"/>
      <rr_wheel pos="0 -0.30" mass="6.0" width="0.10" diameter="0.50"/>
      <fl_wheel mass="6.0" width="0.10" diameter="0.50"/>
      <fr_wheel mass="6.0" width="0.10" diameter="0.50"/>
      <f_wheels_x>1.0</f_wheels_x>
      <f_wheels_d>0.6</f_wheels_d>
      <max_steer_ang_deg>70.0</max_steer_ang_deg>
      <chassis mass="300.0" zmin="0.15" zmax="1.00">
        <shape>
          <pt>-0.35  0.43</pt>
          <pt> 1.00  0.43</pt>
          <pt> 1.40  0.30</pt>
          <pt> 1.40 -0.30</pt>
          <pt> 1.00 -0.43</pt>
          <pt>-0.35 -0.43</pt>
        </shape>
      </chassis>
      <controller class="twist_front_steer_pid">
        <KP>1500</KP> <KI>50</KI> <I_MAX>20</I_MAX> <KD>0</KD>
        <V>0.0</V> <W>0</W>
        <max_torque>600</max_torque>
      </controller>
    </dynamics>
    <friction class="default">
      <mu>0.7</mu>
      <C_damping>0.1</C_damping>
    </friction>
  </vehicle:class>

  <vehicle name="veh" class="compact_car">
    <init_pose>0 0 0</init_pose>
  </vehicle>

  <block:class name="box">
    <static>true</static>
    <color>#30a030</color>
    <zmin>0.0</zmin>
    <zmax>1.2</zmax>
    <shape>
      <pt>-0.2 -0.2</pt>
      <pt>-0.2  0.2</pt>
      <pt> 0.2  0.2</pt>
      <pt> 0.2 -0.2</pt>
    </shape>
  </block:class>

  <!-- Rows of boxes (0.45 m wide, 0.5 m pitch) along x, from x=-6.0 to x=1.5,
       centered at y = -0.9, 0.9, 2.7, 4.5 -->
  <for var="iRow" from="0" to="3">
    <for var="i" from="0" to="14">
      <block class="box">
        <init_pose>$f{-5.75+0.5*i} $f{-0.9+1.8*iRow} 0</init_pose>
      </block>
    </for>
  </for>

  <!-- Opposite side of the crossing aisle: a row of boxes along y, at x=4.2 -->
  <for var="i" from="0" to="19">
    <block class="box">
      <init_pose>4.2 $f{-4.75+0.5*i} 0</init_pose>
    </block>
  </for>
</mvsim_world>
