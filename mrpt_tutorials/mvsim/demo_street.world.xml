<mvsim_world version="1.0">
	<!-- A street with parking bays at different angles, to exercise the A* planner.
	     Static maps and parked cars are generated by ../maps/generate_street_maps.py -->
	<simul_timestep>0</simul_timestep>

	<gui>
		<ortho>false</ortho>
		<show_forces>false</show_forces>
		<cam_distance>45</cam_distance>
		<fov_deg>60</fov_deg>
		<refresh_fps>20</refresh_fps>
		<cam_point_to>30 14 0</cam_point_to>
	</gui>

	<lights>
		<enable_shadows>true</enable_shadows>
		<light_azimuth_deg>60.0</light_azimuth_deg>
		<light_elevation_deg>75.0</light_elevation_deg>
	</lights>

	<!-- ========================
		   Scenario definition
	     ======================== -->
	<!-- Street walls, planter, kiosk and bollards (the parked cars are blocks below) -->
	<element class="occupancy_grid">
		<file>../maps/street_walls.yaml</file>
	</element>

	<!-- Ground: concrete everywhere, road on top -->
	<element class="horizontal_plane">
		<x_min>0</x_min> <y_min>0</y_min>
		<x_max>60</x_max> <y_max>28</y_max>
		<z>0.0</z>
		<texture>https://mrpt.github.io/mvsim-models/textures-cgbookcase/concrete-ground-1.jpg</texture>
		<normal_map>https://mrpt.github.io/mvsim-models/textures-cgbookcase/concrete-ground-1_normal.png</normal_map>
		<texture_size_x>3.0</texture_size_x>
		<texture_size_y>3.0</texture_size_y>
	</element>
	<element class="horizontal_plane">
		<x_min>0</x_min> <y_min>12</y_min>
		<x_max>60</x_max> <y_max>22</y_max>
		<z>0.01</z>
		<texture>https://mrpt.github.io/mvsim-models/textures-cgbookcase/TwoLaneSolidLineRoadClean01_1K_BaseColor.png</texture>
		<normal_map>https://mrpt.github.io/mvsim-models/textures-cgbookcase/TwoLaneSolidLineRoadClean01_1K_NormalGL.png</normal_map>
		<texture_size_x>20</texture_size_x>
		<texture_size_y>10</texture_size_y>
	</element>

	<!-- Brick facades on the inner side of the street walls (visual only) -->
	<element class="vertical_plane">
		<x0>0.5</x0> <y0>27</y0> <x1>59.5</x1> <y1>27</y1>
		<z>0.0</z> <height>6.0</height>
		<texture>https://mrpt.github.io/mvsim-models/textures-cgbookcase/wall-bricks-01.png</texture>
		<normal_map>https://mrpt.github.io/mvsim-models/textures-cgbookcase/wall-bricks-01_normal.png</normal_map>
		<texture_size_x>2.5</texture_size_x>
		<texture_size_y>2.5</texture_size_y>
		<thickness>0.01</thickness>
		<cull_face>NONE</cull_face>
	</element>
	<element class="vertical_plane">
		<x0>0.5</x0> <y0>0.5</y0> <x1>59.5</x1> <y1>0.5</y1>
		<z>0.0</z> <height>3.0</height>
		<texture>https://mrpt.github.io/mvsim-models/textures-cgbookcase/wall-bricks-02.png</texture>
		<normal_map>https://mrpt.github.io/mvsim-models/textures-cgbookcase/wall-bricks-02_normal.png</normal_map>
		<texture_size_x>2.5</texture_size_x>
		<texture_size_y>2.5</texture_size_y>
		<thickness>0.01</thickness>
		<cull_face>NONE</cull_face>
	</element>

	<variable name="DEFS_DIR" value="$(ros2 pkg prefix mvsim)/share/mvsim/definitions"/>

	<!-- =============================
		   Vehicle classes definition
	     ============================= -->
	<include file="car_ackermann.vehicle.xml" controller="${MRPT_TUTORIALS_ACKERMANN_CONTROLLER|twist_front_steer_pid}" />

	<!-- ========================
		   Vehicle(s) definition
	     ======================== -->
	<vehicle name="r1" class="car_ackermann">
		<init_pose>6 17 0</init_pose>  <!-- In global coords: x,y, yaw(deg) -->

		<!-- Sensors -->
		<include file="${DEFS_DIR}/lidar2d.sensor.xml" sensor_x="1.7" sensor_z="1.01" sensor_yaw="0" max_range="70.0" sensor_name="laser1" />
		<include file="${DEFS_DIR}/lidar2d.sensor.xml" sensor_x="-0.5" sensor_z="1.01" sensor_yaw="180" max_range="70.0" sensor_name="laser2" />
	</vehicle>

	<!-- ======================================
	      Obstacle blocks: parked cars as cheap polygonal models
	     ====================================== -->
	<block:class name="parked_car_a">
		<static>true</static>
		<color>#3060c0</color>
		<zmin>0.15</zmin> <zmax>1.5</zmax>
		<shape>
			<pt>-2.25 -1.1</pt>
			<pt> 2.25 -1.1</pt>
			<pt> 2.25  1.1</pt>
			<pt>-2.25  1.1</pt>
		</shape>
	</block:class>
	<block:class name="parked_car_b">
		<static>true</static>
		<color>#c04030</color>
		<zmin>0.15</zmin> <zmax>1.5</zmax>
		<shape>
			<pt>-2.25 -1.1</pt>
			<pt> 2.25 -1.1</pt>
			<pt> 2.25  1.1</pt>
			<pt>-2.25  1.1</pt>
		</shape>
	</block:class>

	<block class="parked_car_a"><init_pose>4.0 2.85 90</init_pose></block>
	<block class="parked_car_b"><init_pose>10.5 2.85 90</init_pose></block>
	<block class="parked_car_a"><init_pose>17.0 2.85 90</init_pose></block>
	<block class="parked_car_b"><init_pose>26.5 3.1 60</init_pose></block>
	<block class="parked_car_a"><init_pose>33.0 3.1 60</init_pose></block>
	<block class="parked_car_b"><init_pose>41.0 3.1 120</init_pose></block>
	<block class="parked_car_a"><init_pose>47.5 3.1 120</init_pose></block>
	<block class="parked_car_b"><init_pose>55.0 2.85 90</init_pose></block>
	<block class="parked_car_a"><init_pose>8.0 24.1 0</init_pose></block>
	<block class="parked_car_b"><init_pose>22.5 24.1 0</init_pose></block>
	<block class="parked_car_a"><init_pose>32.0 24.1 0</init_pose></block>
	<block class="parked_car_b"><init_pose>41.0 24.1 0</init_pose></block>
	<block class="parked_car_a"><init_pose>50.0 24.1 0</init_pose></block>

</mvsim_world>
