<mvsim_world version="1.0">
	<!-- General simulation options -->
	<simul_timestep>0</simul_timestep> <!-- Simulation fixed-time interval for numerical integration [seconds] or 0 to autodetermine -->

	<!-- GUI options -->
	<gui>
		<ortho>false</ortho>
		<show_forces>true</show_forces>  <force_scale>0.01</force_scale>
		<cam_distance>35</cam_distance>
		<fov_deg>60</fov_deg>
		<refresh_fps>20</refresh_fps>
		<cam_point_to>30 30 0</cam_point_to>
		<!-- <follow_vehicle>r1</follow_vehicle> -->
	</gui>

	<!-- ========================
		   Scenario definition
	     ======================== -->
	<element class="occupancy_grid">
		<!-- File can be an image, an MRPT .gridmap file, or a ROS gridmap .yaml file -->
		<file>../maps/demo_world2.yaml</file>
	</element>

	<variable name="DEFS_DIR" value="$(ros2 pkg prefix mvsim)/share/mvsim/definitions"/>

	<!-- =============================
		   Vehicle classes definition
	     ============================= -->
	<!-- Controller overridable with an environment variable (e.g. twist_ideal in tests): -->
	<include file="${DEFS_DIR}/jackal.vehicle.xml" controller="${MRPT_TUTORIALS_DIFFDRIVE_CONTROLLER|twist_pid}" />

	<!-- ========================
		   Vehicle(s) definition
	     ======================== -->
	<vehicle name="r1" class="jackal">
		<init_pose>30 30 0</init_pose>  <!-- In global coords: x,y, yaw(deg) -->

		<!-- Sensors -->
		<include file="${DEFS_DIR}/lidar2d.sensor.xml" sensor_x="0.10" sensor_z="0.35" sensor_yaw="0" fov_degrees="360" sensor_nrays="361" max_range="70.0" sensor_name="laser1" />
	</vehicle>

	<!-- ========================
		   Dynamic obstacle
	     ======================== -->
	<!-- A box that shuttles back and forth across the open area west of the
	     robot start pose, so paths toward the west cross its lane. It is not
	     in the gridmap: navigation only knows about it from the lidar.
	     Disable it with MRPT_TUTORIALS_DYNAMIC_OBSTACLES=false. -->
	<variable name="DYNAMIC_OBSTACLES" value="$env{MRPT_TUTORIALS_DYNAMIC_OBSTACLES|true}"/>
	<if condition="${DYNAMIC_OBSTACLES}">
		<block name="moving_box">
			<mass>50</mass>
			<color>#e01b24</color>
			<zmin>0.0</zmin>
			<zmax>1.5</zmax>
			<shape>
				<pt>-0.5 -0.5</pt>
				<pt>-0.5  0.5</pt>
				<pt> 0.5  0.5</pt>
				<pt> 0.5 -0.5</pt>
			</shape>
			<init_pose>22 21 0</init_pose>
			<!-- (time [s], x, y, yaw [deg]) relative to init_pose, repeated in a
			     loop: 8 m north and back, at 0.5 m/s -->
			<animation type="keyframes">
				<time_pose>0.0   0 0 0</time_pose>
				<time_pose>3.0   0 0 0</time_pose>
				<time_pose>19.0  0 8 0</time_pose>
				<time_pose>22.0  0 8 0</time_pose>
				<time_pose>38.0  0 0 0</time_pose>
			</animation>
		</block>
	</if>

</mvsim_world>
